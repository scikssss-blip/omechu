{
  "outputDirectory": ".",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/3d",
      "destination": "/pocha3d.html?room=street",
      "permanent": false
    },
    {
      "source": "/street",
      "destination": "/pocha3d.html?room=street",
      "permanent": false
    },
    {
      "source": "/meokja",
      "destination": "/pocha3d.html?room=street",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/images/:path*",
      "destination": "/public/images/:path*"
    }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
